{
  "name": "emotid",
  "private": true,
  "version": "0.1.0",
  "description": "Emotion identification system",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "npm": ">=9.0.0"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "dev": "vite --host",
    "type-check": "tsc -b",
    "type-check:watch": "tsc -b -w",
    "build": "npm run type-check && vite build",
    "lint": "eslint . --ignore-pattern coverage --ignore-pattern playwright-report --ignore-pattern test-results --max-warnings 0",
    "lint:all": "npm run lint && npm run type-check",
    "preview": "vite preview",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --fix",
    "format": "npm run lint:fix",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:performance": "npm run build && npm run test:performance:run",
    "test:performance:run": "playwright test --config=playwright.performance.config.ts",
    "test:android:physical": "node ./scripts/android-physical-audit.mjs",
    "test:e2e:ui": "playwright test --ui",
    "check-keys": "node ./check_i18n_keys.cjs",
    "check-translations": "node ./check_translations.cjs",
    "test:catalog-review": "node --test ./scripts/catalog-guidance-review.test.mjs",
    "prepare:catalog-review": "node ./scripts/catalog-guidance-review.mjs prepare --source negative-high.json --batch-id p26-negative-high-01 --out-dir .reports/catalog-guidance/p26-negative-high-01",
    "prepare:catalog-review:quick-body": "node ./scripts/catalog-guidance-review.mjs prepare --surface quick-body --batch-id p26-quick-body-needs-01 --out-dir .reports/catalog-guidance/p26-quick-body-needs-01",
    "prepare:catalog-review:affect": "node ./scripts/catalog-guidance-review.mjs prepare --surface affect --batch-id p26-affect-needs-01 --out-dir .reports/catalog-guidance/p26-affect-needs-01",
    "prepare:catalog-review:plutchik": "node ./scripts/catalog-guidance-review.mjs prepare --surface plutchik --batch-id p26-plutchik-needs-01 --out-dir .reports/catalog-guidance/p26-plutchik-needs-01",
    "prepare:catalog-review:word-ladder": "node ./scripts/catalog-guidance-review.mjs prepare --surface word-ladder --batch-id p26-word-ladder-needs-01 --out-dir .reports/catalog-guidance/p26-word-ladder-needs-01",
    "check-copy": "node ./check_psychological_copy.cjs && npm run test:catalog-review",
    "check-performance": "node ./scripts/check-performance-budget.mjs",
    "precheck": "node -e \"const p=require('./package.json');const required=['check-translations','check-copy','lint','test','build','type-check'];required.forEach(s=>{if(!p.scripts[s])console.error('missing script:',s),process.exit(1);});['check-keys','check-translations','check-untranslated','check-copy'].forEach(k=>{const v=p.scripts[k];if(!v)throw new Error('script missing: '+k);if(v.includes('./node_modules/.bin/')||v.includes('jest'))throw new Error('deprecated script: '+k)})\"",
    "check-untranslated": "node ./check_i18n_untranslated.cjs",
    "i18n-audit": "npm run check-keys && npm run check-translations && npm run check-untranslated",
    "check": "npm run lint && npm run test && npm run i18n-audit && npm run check-copy && npm run build && npm run check-performance"
  },
  "dependencies": {
    "framer-motion": "^12.29.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "@trickfilm400/rollup-plugin-off-main-thread": {
      "ejs": "^6.0.1"
    }
  }
}
